# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Administrative API Configuration (Required for Auth user management)
# Used exclusively in server-side admin operations (createUser, deleteUser).
# Never expose this key client-side.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Database Configuration (SQLite)
DATABASE_URL="file:./hms.db"
